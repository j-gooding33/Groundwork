{
  "chapter1": [
    {
      "id": "l1_ground",
      "text": "Start with the ground.",
      "highlight": {
        "tile": {
          "x": 37,
          "y": 29
        }
      },
      "when": "placed:clay_pit",
      "pauseSim": true
    },
    {
      "id": "l1_source",
      "text": "Everything starts somewhere.",
      "highlight": {
        "ui": "trace"
      },
      "when": "produced:clay",
      "waitTicks": 20
    },
    {
      "id": "l1_kiln",
      "text": "Clay becomes brick in a kiln.",
      "highlight": {
        "tile": {
          "x": 40,
          "y": 28
        },
        "size": [
          2,
          2
        ]
      },
      "grant": {
        "unlock": [
          "brick_kiln"
        ]
      },
      "when": "placed:brick_kiln"
    },
    {
      "id": "l1_carry",
      "text": "Tap the pit to pick up clay.\nTap the kiln to drop it.",
      "highlight": {
        "building": "clay_pit"
      },
      "when": "delivered:clay:hand"
    },
    {
      "id": "l1_first_brick",
      "text": "Watch the kiln.",
      "highlight": {
        "building": "brick_kiln"
      },
      "when": "produced:brick"
    },
    {
      "id": "l1_belt",
      "text": "Pick Belt. Drag from the pit\nto the kiln, or tap one then the other.",
      "highlight": {
        "building": "clay_pit",
        "ui": "build"
      },
      "grant": {
        "beltTiles": 12
      },
      "when": "linked:clay_pit:brick_kiln"
    },
    {
      "id": "l1_look",
      "text": "Drag to look around.\nPinch to zoom.",
      "when": "wait",
      "waitTicks": 100
    },
    {
      "id": "l1_undo",
      "text": "Made a mistake? Undo is free.",
      "highlight": {
        "ui": "undo"
      },
      "when": "wait",
      "waitTicks": 60
    },
    {
      "id": "l1_foundation",
      "text": "Bricks fill the foundation.\nBelt or carry them there.",
      "highlight": {
        "building": "foundation"
      },
      "when": "waiting:log"
    },
    {
      "id": "l1_logs",
      "text": "The kiln has stopped.\nTap Trace, then the kiln.",
      "highlight": {
        "building": "brick_kiln",
        "ui": "trace"
      },
      "when": "traced:brick_kiln",
      "pauseSim": true
    },
    {
      "id": "l1_lumber",
      "text": "Trace found it: no logs.\nPlace a Lumber Camp on the forest.",
      "highlight": {
        "tile": {
          "x": 42,
          "y": 23
        }
      },
      "grant": {
        "unlock": [
          "lumber_camp",
          "storage_crate"
        ],
        "beltTiles": 6
      },
      "when": "placed:lumber_camp"
    },
    {
      "id": "l1_log_belt",
      "text": "Belt the logs to the kiln.",
      "highlight": {
        "building": "lumber_camp"
      },
      "when": "linked:lumber_camp:brick_kiln"
    },
    {
      "id": "l1_finish",
      "text": "Fill the foundation.",
      "highlight": {
        "building": "foundation"
      },
      "when": "goal"
    }
  ],
  "chapter2": [
    {
      "id": "c2_crate",
      "text": "A crate appeared by the kiln.\nBelt bricks into it.",
      "highlight": {
        "building": "storage_crate"
      },
      "when": "linked:brick_kiln:storage_crate"
    },
    {
      "id": "c2_trace",
      "text": "Is one pit enough?\nTrace the kiln to see.",
      "highlight": {
        "building": "brick_kiln",
        "ui": "trace"
      },
      "when": "traced:brick_kiln",
      "pauseSim": true
    },
    {
      "id": "c2_second",
      "text": "More clay, more bricks.\nAdd a second Clay Pit.",
      "highlight": {
        "tile": {
          "x": 34,
          "y": 31
        }
      },
      "when": "count:clay_pit:2"
    },
    {
      "id": "c2_merge",
      "text": "End its belt on the side of\nthe first belt. They merge.",
      "highlight": {
        "building": "clay_pit"
      },
      "when": "wait",
      "waitTicks": 200
    },
    {
      "id": "c2_goal",
      "text": "Fill the crate with bricks.",
      "highlight": {
        "building": "storage_crate"
      },
      "when": "goal"
    }
  ],
  "chapter3": [
    {
      "id": "c3_start",
      "text": "Cottages need bricks and planks.\nMore land is open to build on.",
      "highlight": {
        "tile": {
          "x": 47,
          "y": 25
        }
      },
      "when": "wait",
      "waitTicks": 60
    },
    {
      "id": "c3_sawmill",
      "text": "Cottages need planks.\nPlace a Sawmill.",
      "highlight": {
        "tile": {
          "x": 47,
          "y": 25
        }
      },
      "when": "placed:sawmill"
    },
    {
      "id": "c3_saw_logs",
      "text": "Belt logs to the sawmill.",
      "highlight": {
        "tile": {
          "x": 44,
          "y": 23
        }
      },
      "when": "linked:lumber_camp:sawmill"
    },
    {
      "id": "c3_yard",
      "text": "A Builder's Yard builds homes.\nPlace one.",
      "highlight": {
        "tile": {
          "x": 51,
          "y": 28
        }
      },
      "when": "placed:builders_yard"
    },
    {
      "id": "c3_bricks",
      "text": "Belt bricks to the yard.",
      "highlight": {
        "building": "builders_yard"
      },
      "when": "linked:brick_kiln:builders_yard"
    },
    {
      "id": "c3_planks",
      "text": "Now belt planks to the yard.",
      "highlight": {
        "building": "sawmill"
      },
      "when": "linked:sawmill:builders_yard"
    },
    {
      "id": "c3_steady",
      "text": "The yard starts a cottage once\nbricks and planks keep coming.",
      "highlight": {
        "building": "builders_yard"
      },
      "when": "placed:cottage"
    },
    {
      "id": "c3_trace",
      "text": "Trace a cottage back to nature.",
      "highlight": {
        "building": "cottage",
        "ui": "trace"
      },
      "when": "traced:cottage",
      "waitTicks": 100
    },
    {
      "id": "c3_goal",
      "text": "Keep it flowing. Five cottages.",
      "when": "goal"
    }
  ]
}
