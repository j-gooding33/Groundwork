{
  "level1": [
    { "id": "l1_ground", "text": "Start with the ground.",
      "highlight": { "tile": { "x": 37, "y": 29 } },
      "when": "placed:clay_pit", "pauseSim": true },
    { "id": "l1_source", "text": "Everything starts somewhere.",
      "highlight": { "ui": "trace" },
      "when": "produced:clay" },
    { "id": "l1_kiln", "text": "Clay becomes brick in a kiln.",
      "highlight": { "tile": { "x": 41, "y": 28 } },
      "grant": { "unlock": ["brick_kiln"] },
      "when": "placed:brick_kiln" },
    { "id": "l1_carry", "text": "Carry clay from the pit\nto the kiln.",
      "highlight": { "building": "clay_pit" },
      "when": "delivered:clay:hand" },
    { "id": "l1_first_brick", "text": "Watch the kiln.",
      "highlight": { "building": "brick_kiln" },
      "when": "produced:brick" },
    { "id": "l1_belt", "text": "Drag a belt from the pit to the kiln.",
      "highlight": { "building": "clay_pit" },
      "grant": { "beltTiles": 12 },
      "when": "delivered:clay:belt" },
    { "id": "l1_foundation", "text": "Bricks fill the foundation.\nBelt or carry them there.",
      "highlight": { "building": "foundation" },
      "when": "delivered:brick:foundation" },
    { "id": "l1_logs", "text": "The kiln needs logs to burn.\nTap Trace to see why.",
      "highlight": { "ui": "trace" },
      "grant": { "unlock": ["lumber_camp", "storage_crate"] },
      "when": "waiting:log" },
    { "id": "l1_lumber", "text": "Place a Lumber Camp on the forest.",
      "highlight": { "tile": { "x": 42, "y": 23 } },
      "grant": { "beltTiles": 6 },
      "when": "placed:lumber_camp" },
    { "id": "l1_finish", "text": "Fill the foundation.",
      "highlight": { "building": "foundation" },
      "when": "goal" }
  ],
  "level3": [
    { "id": "l3_yard", "text": "A Builder's Yard builds homes\nwhen supply is steady.",
      "highlight": { "ui": "build" },
      "when": "placed:builders_yard" },
    { "id": "l3_planks", "text": "Cottages need planks too.\nTry a Sawmill.",
      "when": "placed:sawmill" },
    { "id": "l3_feed", "text": "Belt bricks and planks to the yard.",
      "highlight": { "building": "builders_yard" },
      "when": "placed:cottage" },
    { "id": "l3_grow", "text": "Keep it flowing. Five cottages.",
      "when": "goal" }
  ]
}
